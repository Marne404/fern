; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fern"
config/description="An endless, cozy hiking game through beautiful stylized nature"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

Settings="*res://scripts/core/settings.gd"
Voice="*res://scripts/audio/voice.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/aspect="expand"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.95, 1)

[shader_globals]

wind_direction={
"type": "vec2",
"value": Vector2(0.94, 0.34)
}
wind_strength={
"type": "float",
"value": 1.0
}
wind_noise={
"type": "sampler2D",
"value": "res://assets/wind_noise.tres"
}
world_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_strength={
"type": "float",
"value": 0.55
}
player_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
sand_storm={
"type": "float",
"value": 0.0
}
grass_fade={
"type": "vec2",
"value": Vector2(35, 50)
}
